# Server configuration (optional; defaults to 3000)
PORT=3000

# Guardian Copilot AI providers (at least one key recommended for live LLM classification)
# Primary failover: Groq -> Google Gemini. If neither is set, messages degrade cleanly to neutral defaults.
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Nexconn Chat SDK credentials (from https://console.nexconn.ai)
# Leave empty to run in local sandbox token mode for development and evaluation.
NEXCONN_APP_KEY=""
NEXCONN_APP_SECRET=""
NEXCONN_API_HOST="https://api.us-east-1.nexconn.ai"
